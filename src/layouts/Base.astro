---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { useTranslations, type Lang, type PageKey } from '../i18n';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Item ativo na navegação. */
  active?: PageKey;
  /** Caminho equivalente em cada idioma (para o seletor e hreflang). */
  alternates: Record<Lang, string>;
  noindex?: boolean;
  /** Só na raiz PT: detecta o idioma do navegador na primeira visita. */
  detectLanguage?: boolean;
}

const { lang, title, description, active, alternates, noindex = false, detectLanguage = false } = Astro.props;
const t = useTranslations(lang);
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL('/og-image.png', site).href;
---

<!doctype html>
<html lang={lang === 'pt' ? 'pt-BR' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0F1026" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {!noindex && (
      <>
        <link rel="alternate" hreflang="pt-BR" href={new URL(alternates.pt, site).href} />
        <link rel="alternate" hreflang="en" href={new URL(alternates.en, site).href} />
        <link rel="alternate" hreflang="x-default" href={new URL(alternates.pt, site).href} />
      </>
    )}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.meta.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'pt' ? 'pt_BR' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'pt' ? 'en_US' : 'pt_BR'} />
    <meta name="twitter:card" content="summary_large_image" />

    {detectLanguage && (
      <script is:inline>
        try {
          if (!localStorage.getItem('lang')) {
            var en = !/^pt\b/i.test(navigator.language || '');
            localStorage.setItem('lang', en ? 'en' : 'pt');
            if (en) location.replace('/en/');
          }
        } catch (e) {}
      </script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <Header lang={lang} active={active} alternates={alternates} />
    <main id="main" class="container">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>

<style>
  main { flex: 1; }
  .skip-link {
    position: absolute; left: 12px; top: -48px; z-index: 100;
    padding: 10px 14px; border-radius: var(--radius-md);
    background: var(--color-surface); color: var(--color-accent-300); box-shadow: var(--shadow-md);
  }
  .skip-link:focus-visible { top: 12px; }
</style>
