---
import { useTranslations, type Lang } from '../i18n';
import { FORMSPREE_ID, EMAIL } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const action = FORMSPREE_ID ? `https://formspree.io/f/${FORMSPREE_ID}` : '';
---

<form
  class="contact-form"
  method="POST"
  action={action || undefined}
  data-contact-form
  data-label={t.contact.send}
  data-sending={t.contact.sending}
  data-sent={t.contact.sent}
>
  <input type="hidden" name="_subject" value={t.contact.subject} />
  <input type="hidden" name="language" value={lang} />
  <div class="field">
    <label for="cf-name">{t.contact.name}</label>
    <input id="cf-name" class="input" name="name" autocomplete="name" required />
  </div>
  <div class="field">
    <label for="cf-email">{t.contact.email}</label>
    <input id="cf-email" class="input" type="email" name="email" autocomplete="email" required />
  </div>
  <fieldset class="field">
    <legend class="field-label">{t.contact.type}</legend>
    <div class="seg">
      {t.contact.types.map((type, i) => (
        <label class="seg-btn">
          <input type="radio" name="projectType" value={type} checked={i === 0} />
          {type}
        </label>
      ))}
    </div>
  </fieldset>
  <div class="field">
    <label for="cf-message">{t.contact.message}</label>
    <textarea id="cf-message" class="input" name="message" rows="5" minlength="10" required></textarea>
  </div>
  <button class="btn btn-primary" type="submit">{t.contact.send}</button>
  <p class="form-error" role="alert" data-form-error hidden>
    {t.contact.error} <a href={`mailto:${EMAIL}`}>{EMAIL}</a>.
  </p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const error = form.querySelector<HTMLElement>('[data-form-error]')!;
    const { label, sending, sent } = form.dataset;
    let state: 'idle' | 'sending' | 'success' | 'error' = 'idle';

    const set = (next: typeof state) => {
      state = next;
      button.disabled = next === 'sending' || next === 'success';
      button.textContent = next === 'sending' ? sending! : next === 'success' ? sent! : label!;
      error.hidden = next !== 'error';
    };

    form.addEventListener('input', () => {
      if (state === 'success' || state === 'error') set('idle');
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.reportValidity() || state === 'sending') return;
      if (!form.getAttribute('action')) return set('error'); // FORMSPREE_ID não configurado
      set('sending');
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        set('success');
      } catch {
        set('error');
      }
    });
  });
</script>

<style>
  .contact-form {
    display: flex; flex-direction: column; gap: 16px; padding: 28px; align-self: start;
    border-radius: var(--radius-lg); background: #051C30; box-shadow: var(--shadow-sm);
  }
  .contact-form .btn { align-self: flex-start; }
  .form-error { font-size: 13px; color: var(--color-accent-300); }
  .form-error a { color: var(--color-accent-300); }
  @media (max-width: 720px) {
    .seg-btn { min-height: 44px; padding-inline: 14px; }
  }
</style>
