---
import { Image } from 'astro:assets';
import { useTranslations, projectPath, type Lang } from '../i18n';
import type { Project } from '../lib/projects';

interface Props { project: Project; lang: Lang }
const { project, lang } = Astro.props;
const t = useTranslations(lang);
const d = project.data;
const locked = d.protected;
---

<a class="card" href={projectPath(project.slug, lang)}>
  {/* `thumb` é público mesmo em case protegido; sem ele, o protegido mostra o fundo desfocado. */}
  <div class:list={['thumb', { 'is-locked': locked && !d.thumb, 'has-img': d.thumb }]}>
    {d.thumb && <Image src={d.thumb} alt="" width={720} class="thumb-img" />}
    <span class="thumb-meta">
      <span>{d.code}</span>
      {locked ? <span class="lock-tag">{t.work.locked}</span> : !d.thumb && <span>{t.work.thumb}</span>}
    </span>
  </div>
  <div class="body">
    <div class="row"><span>{d.type}</span><span>{d.year}</span></div>
    <h2>{d.title}</h2>
    <p>{locked ? t.work.lockedSummary : d.summary}</p>
    <span class="cta">{t.work.viewCase} →</span>
  </div>
</a>

<style>
  .card {
    display: flex; flex-direction: column; overflow: hidden; text-decoration: none; color: var(--color-text);
    background: #051C30; border-radius: var(--radius-md); box-shadow: var(--shadow-sm);
    transition: box-shadow .2s;
  }
  .card:hover { color: var(--color-text); box-shadow: 0 0 0 1px #EE4B62, 0 0 24px color-mix(in srgb, #EE4B62 25%, transparent); }
  .thumb {
    position: relative; aspect-ratio: 16 / 9; overflow: hidden;
    background: linear-gradient(135deg, #042F40, #2e1220);
  }
  .thumb-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

  /* Com imagem: filtro escuro na paleta do site para o código ficar legível.
     No hover/foco, o filtro e o texto somem e a imagem aparece limpa. */
  .thumb.has-img .thumb-img { filter: saturate(.55) brightness(.75); transition: filter .3s; }
  .thumb.has-img::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background:
      linear-gradient(to top, color-mix(in srgb, #0F1026 85%, transparent), transparent 60%),
      linear-gradient(135deg, color-mix(in srgb, #042F40 55%, transparent), color-mix(in srgb, #2e1220 55%, transparent));
    transition: opacity .3s;
  }
  .thumb.has-img .thumb-meta { color: var(--color-neutral-300); transition: opacity .3s; }
  .card:is(:hover, :focus-visible) .thumb.has-img .thumb-img { filter: none; }
  .card:is(:hover, :focus-visible) .thumb.has-img::after,
  .card:is(:hover, :focus-visible) .thumb.has-img .thumb-meta { opacity: 0; }
  .thumb.is-locked::before {
    content: ''; position: absolute; inset: -20px;
    background:
      repeating-linear-gradient(90deg, color-mix(in srgb, #AFD7FA 10%, transparent) 0 2px, transparent 2px 22px),
      radial-gradient(60% 80% at 30% 40%, #2e1220, transparent),
      radial-gradient(50% 70% at 75% 60%, #042F40, transparent);
    filter: blur(8px);
  }
  .thumb.is-locked::after { content: ''; position: absolute; inset: 0; background: color-mix(in srgb, #0F1026 45%, transparent); }
  .thumb-meta {
    position: absolute; inset: auto 0 0 0; z-index: 1;
    display: flex; align-items: flex-end; justify-content: space-between; gap: 12px; padding: 14px;
    font-size: 11px; letter-spacing: .15em; color: var(--color-neutral-500);
  }
  .lock-tag { letter-spacing: .2em; color: var(--color-accent-300); }
  .body { display: flex; flex-direction: column; gap: 8px; padding: 18px 20px 22px; }
  .row { display: flex; justify-content: space-between; gap: 12px; font-size: 12px; color: var(--color-neutral-500); }
  .body h2 { font-size: 20px; }
  .body p { font-size: 14px; color: var(--color-neutral-400); }
  .cta { margin-top: 6px; font-size: 13px; color: var(--color-accent-300); }
</style>
