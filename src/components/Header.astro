---
import { useTranslations, routes, navOrder, languages, type Lang, type PageKey } from '../i18n';

interface Props {
  lang: Lang;
  active?: PageKey;
  alternates: Record<Lang, string>;
}

const { lang, active, alternates } = Astro.props;
const t = useTranslations(lang);
const items = navOrder.map((key) => ({ key, href: routes[key][lang], label: t.nav[key] }));
---

<header class="site-header">
  <a class="brand" href={routes.home[lang]} aria-label="L. Gelain — {t.nav.home}">
    <span class="brand-mark" aria-hidden="true"></span>
    <span class="brand-name">L. Gelain</span>
    <span class="brand-role">// DEV.FULLSTACK</span>
  </a>
  <div class="controls">
    <nav class="nav" aria-label="Principal">
      {items.map((i) => (
        <a href={i.href} aria-current={active === i.key ? 'page' : undefined}>{i.label}</a>
      ))}
    </nav>
    <div class="seg lang" role="group" aria-label={t.langLabel}>
      {languages.map((code) => (
        <a
          class:list={['seg-btn', { 'is-active': code === lang }]}
          href={alternates[code]}
          hreflang={code === 'pt' ? 'pt-BR' : 'en'}
          lang={code === 'pt' ? 'pt-BR' : 'en'}
          aria-current={code === lang ? 'true' : undefined}
          data-lang-switch={code}
        >{code.toUpperCase()}</a>
      ))}
    </div>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu">{t.menu}</button>
  </div>
</header>

<div id="mobile-menu" class="mobile-panel" hidden>
  <div class="mobile-top">
    <span class="brand-name">L. Gelain</span>
    <button class="menu-close" type="button">{t.close}</button>
  </div>
  <nav aria-label="Principal">
    {items.map((i, n) => (
      <a href={i.href} aria-current={active === i.key ? 'page' : undefined}>
        <span class="mobile-num">0{n + 1}</span>{i.label}
      </a>
    ))}
  </nav>
</div>

<script>
  const panel = document.getElementById('mobile-menu')!;
  const openBtn = document.querySelector<HTMLButtonElement>('.menu-btn')!;
  const closeBtn = panel.querySelector<HTMLButtonElement>('.menu-close')!;

  const setOpen = (open: boolean) => {
    panel.hidden = !open;
    openBtn.setAttribute('aria-expanded', String(open));
    document.documentElement.style.overflow = open ? 'hidden' : '';
    (open ? closeBtn : openBtn).focus();
  };
  openBtn.addEventListener('click', () => setOpen(true));
  closeBtn.addEventListener('click', () => setOpen(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !panel.hidden) setOpen(false);
  });
  matchMedia('(min-width: 721px)').addEventListener('change', (e) => {
    if (e.matches && !panel.hidden) setOpen(false);
  });

  // Preferência explícita de idioma: não redireciona mais automaticamente.
  document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]').forEach((a) =>
    a.addEventListener('click', () => {
      try { localStorage.setItem('lang', a.dataset.langSwitch!); } catch {}
    })
  );
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 10;
    display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 20px;
    padding: 16px var(--gutter);
    background: color-mix(in srgb, #0F1026 82%, transparent);
    -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-divider);
  }
  .brand { display: flex; align-items: center; gap: 12px; color: var(--color-text); text-decoration: none; }
  .brand:hover { color: var(--color-text); }
  .brand-mark { width: 10px; height: 10px; flex: none; background: #EE4B62; box-shadow: 0 0 12px #EE4B62; }
  .brand-name { font-size: 13px; font-weight: 500; letter-spacing: .18em; text-transform: uppercase; }
  .brand-role { font-size: 11px; letter-spacing: .12em; color: var(--color-neutral-500); }

  .controls { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .nav { display: flex; gap: 2px; flex-wrap: wrap; }
  .nav a {
    padding: 8px 10px; border-radius: var(--radius-sm);
    font-size: 13px; letter-spacing: .04em; text-decoration: none; color: var(--color-neutral-400);
  }
  .nav a:hover { color: var(--color-neutral-200); }
  .nav a[aria-current='page'] { color: var(--color-accent-300); box-shadow: inset 0 -1px 0 var(--color-accent); }

  .menu-btn, .menu-close {
    display: none; min-height: 44px; padding: 0 14px; cursor: pointer;
    font-size: 12px; letter-spacing: .18em; color: var(--color-neutral-300);
    background: transparent; border: 1px solid var(--color-neutral-800); border-radius: var(--radius-sm);
  }
  .menu-close { display: inline-flex; align-items: center; }

  .mobile-panel {
    position: fixed; inset: 0; z-index: 50; overflow-y: auto;
    display: flex; flex-direction: column; gap: 32px;
    padding: 16px var(--gutter) 40px; background: #0F1026;
  }
  .mobile-panel[hidden] { display: none; }
  .mobile-top { display: flex; justify-content: space-between; align-items: center; }
  .mobile-panel nav { display: flex; flex-direction: column; }
  .mobile-panel nav a {
    display: flex; align-items: baseline; gap: 16px; min-height: 56px; padding: 12px 0;
    font-size: 28px; letter-spacing: -.02em; text-decoration: none; color: var(--color-text);
    border-top: 1px solid var(--color-divider);
  }
  .mobile-panel nav a[aria-current='page'] { color: var(--color-accent-300); }
  .mobile-num { font-size: 11px; letter-spacing: .2em; color: var(--color-neutral-500); }

  @media (max-width: 720px) {
    .site-header { flex-wrap: nowrap; padding-block: 10px; }
    .brand-role { display: none; }
    .nav { display: none; }
    .menu-btn { display: inline-flex; align-items: center; }
    .controls { flex-wrap: nowrap; gap: 8px; }
    .lang .seg-btn { min-height: 44px; min-width: 44px; }
  }
</style>
