---
import Base from '../layouts/Base.astro';
import { useTranslations, routes } from '../i18n';

// O GitHub Pages serve um único 404.html para qualquer rota; mostramos PT e EN.
const pt = useTranslations('pt');
const en = useTranslations('en');
---

<Base lang="pt" title={pt.meta.notFound.title} description={pt.meta.notFound.description} alternates={routes.home} noindex>
  <section class="nf">
    <div class="grid-floor" aria-hidden="true"><div class="grid-plane"></div></div>
    <div class="nf-body">
      <span class="kicker">{pt.notFound.kicker}</span>
      <h1><span class="code hl">404</span> {pt.notFound.title}</h1>
      <p>{pt.notFound.text}</p>
      <p class="en" lang="en">{en.notFound.title} {en.notFound.text}</p>
      <div class="ctas">
        <a class="btn btn-primary" href={routes.home.pt}>{pt.notFound.cta}</a>
        <a class="btn btn-ghost" href={routes.home.en} lang="en">{en.notFound.cta}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf { position: relative; overflow: hidden; padding: clamp(64px, 10vw, 120px) 0 180px; }
  .nf-body { position: relative; display: flex; flex-direction: column; gap: 22px; max-width: 720px; }
  h1 { font-size: clamp(36px, 5.5vw, 64px); letter-spacing: -.035em; line-height: 1.02; }
  .code { display: block; font-size: 1.6em; letter-spacing: -.05em; }
  p { font-size: 17px; line-height: 1.6; color: var(--color-neutral-400); }
  .en { font-size: 14px; color: var(--color-neutral-500); }
  .ctas { display: flex; gap: 12px; flex-wrap: wrap; }
  .grid-floor {
    position: absolute; left: -20%; right: -20%; bottom: -40px; height: 300px;
    perspective: 340px; pointer-events: none;
    -webkit-mask-image: linear-gradient(to top, #000 10%, transparent 90%);
    mask-image: linear-gradient(to top, #000 10%, transparent 90%);
  }
  .grid-plane {
    position: absolute; inset: 0; transform: rotateX(62deg); transform-origin: bottom;
    background-image: linear-gradient(#3f85a8 1px, transparent 1px), linear-gradient(90deg, #3f85a8 1px, transparent 1px);
    background-size: 56px 56px; opacity: .55;
  }
</style>
