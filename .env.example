# Uma senha por case protegido: PROJECT_PW_<SLUG em maiúsculas, hífens viram _>
# Use senhas longas e aleatórias (>= 12 caracteres).
PROJECT_PW_INOVA=

# Cases com `release` no frontmatter: token fine-grained (github_pat_…) SÓ de leitura
# (Contents: Read-only) e SÓ do repositório de releases. Vai dentro do payload
# criptografado: quem tiver a senha do case consegue extraí-lo.
PROJECT_RELEASE_TOKEN_INOVA=
